---
cluster: "pax"

form:
  - bc_num_hours
  - num_cores
  - num_memory
  - gpu_partition
  - gpu_type 
  - version
  - modeldir
  
attributes:
  num_cores:
    widget: "select"
    label: "Cores"
    options:
      - ["8", "8"]
      - ["12", "12"]
      - ["16", "16"]
      - ["24", "24"]
      - ["32", "32"]

  num_memory:
    widget: "select"
    label: "Memory"
    options:
      - ["16GB", "16000"]
      - ["24GB", "24000"]
      - ["32GB", "32000"]
      - ["64GB", "64000"]
      - ["96GB", "96000"]       

  gpu_partition:
    widget: "select"
    label: "Partition"
    help: "NOTE: jobs submitted to the preempt partition may get automatically killed to allow higher priority jobs to run"
    options:
      - ["preempt"]
      - ["gpu"]
    value: "preempt"

  gpu_type:
    widget: "select"
    label: "GPU type"
    help: "gpu partition has a100, a100-80GB and p100, preempt partition has all listed gpu types."
    options:
      - ["any"]
      - ["a100"]
      - ["a100-80GB"]
      - ["h200"]
      - ["l40"]
      - ["rtx_a5000"] 
      - ["rtx_a6000"]
      - ["rtx_6000ada"]
    value: "a100"

  version:
    label: Version
    widget: select
    options:
          - ["2.6"]

  modeldir:
    label: Model directory
    widget: path_selector
    value: "/cluster/tufts/hpc/tools/text-generation-webui/models"
    directory: /cluster/tufts
    favorites:
      - /cluster/tufts
      - /cluster/home 
    help: |
          A selection of commonly used models are available at `/cluster/tufts/hpc/tools/text-generation-webui/models` (managed by Research Technology).  
          You may also provide your own model path if preferred.
