#!/bin/bash

# =========================
# Environment & Directories
# =========================
MODELDIR=<%= context.modeldir %>
VER="<%= context.version %>"
WEBUI_REPO="/cluster/tufts/hpc/tools/text-generation-webui"
IMAGE="/cluster/tufts/ngc/images/text-generation-webui_${VER}.sif"
CONFIG="$PWD/config.json"
PROGRAM="start_linux.sh"
CACHEDIR=$HOME/text_generation/cache
LOGDIR=$HOME/text_generation/logs


# =========================
# Load Modules
# =========================
module purge
module load singularity
module list

# =========================
# Directory Setup
# =========================
mkdir -p "$CACHEDIR"
mkdir -p "$LOGDIR"

# =========================
# Logging Info
# =========================
echo "🔌 Using port: $port"
echo "🌐 Running on host: $host"
echo "📁 Model dir: $MODELDIR"
echo "📦 Cache dir: $CACHEDIR"
echo "📦 Logs dir: $LOGDIR"
# =========================
# Run the Container
# =========================
singularity run --nv \
  --bind "$CACHEDIR:/opt/text-generation-webui/cache" \
  --bind "$LOGDIR:/opt/text-generation-webui/logs" \
  --bind "$WEBUI_REPO/characters:/opt/text-generation-webui/characters" \
  --bind "$WEBUI_REPO/instruction-templates:/opt/text-generation-webui/instruction-templates" \
  --bind "$WEBUI_REPO/loras:/opt/text-generation-webui/loras" \
  --bind "$MODELDIR:/opt/text-generation-webui/models" \
  --bind "$WEBUI_REPO/presets:/opt/text-generation-webui/presets" \
  --bind "$WEBUI_REPO/prompts:/opt/text-generation-webui/prompts" \
  --bind "$WEBUI_REPO/training:/opt/text-generation-webui/training" \
  "$IMAGE" \
  $PROGRAM \
  --listen \
  --listen-port "$port" \
  --listen-host "$host" \
  --gradio-auth "$USER:$password" \
  --verbose